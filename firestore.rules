rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('^(6266|4144|70029)@movebuss\\.local$')
      );
    }
    
    function matFromEmail() {
      return request.auth.token.email.split('@')[0];
    }

    // Coleção de usuários
    match /usuarios/{mat} {
      allow read: if isAdmin() || (request.auth != null && mat == matFromEmail());
      allow write: if isAdmin(); // só admin cadastra usuários
    }

    // Coleção de relatórios
    match /relatorios/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.matricula == matFromEmail());
      allow create: if isAdmin(); // só admin cria relatórios
      allow update, delete: if isAdmin(); // só admin edita ou exclui
    }
  }
}